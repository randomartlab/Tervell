+package gateway
+
+import (
+	"context"
+	"encoding/json"
+	"slices"
+	"strings"
+
+	"github.com/yetone/magpie/internal/provider"
+)
+
+// Tervell's model picker preserves the vendor's own level, including aliases
+// that the generic translation IR normalises. This is opt-in per request and
+// only a level explicitly offered by the selected upstream model is restored.
+// Group selection, accounts, fallback, and user extraBody still run normally.
+// Codex Ultra is a client orchestration mode, not a raw API effort.
+type tervellEffortAllowed struct{}
+type tervellEffortKey struct{}
+
+func tervellExactEffort(ctx context.Context, p provider.Provider, to provider.Protocol, body []byte) []byte {
+	if allowed, ok := ctx.Value(tervellEffortAllowed{}).(bool); ok && !allowed {
+		return body
+	}
+	effort, _ := ctx.Value(tervellEffortKey{}).(string)
+	model := p.RequestModel(ctx)
+	if effort == "" || len(effort) > 64 || strings.ContainsAny(effort, "\r\n") || model == "" || !slices.Contains(p.Efforts(model), effort) {
+		return body
+	}
+	if effort == "ultra" && (provider.OffersUltra(model) || p.Account != nil && p.Account.Agent == "codex") {
+		return body
+	}
+	if to == provider.Anthropic && !bodyHas(body, "output_config") {
+		body = withFields(body, map[string]any{"output_config": map[string]any{}})
+	}
+	if to == provider.Gemini {
+		var top map[string]json.RawMessage
+		if decodeJSON(body, &top) != nil {
+			return body
+		}
+		config := map[string]any{}
+		if raw := top["generationConfig"]; len(raw) > 0 {
+			if decodeJSON(raw, &config) != nil {
+				return body
+			}
+		}
+		if effort == "none" {
+			config["thinkingConfig"] = map[string]any{"thinkingBudget": 0}
+		} else {
+			config["thinkingConfig"] = map[string]any{"thinkingLevel": effort}
+		}
+		return withFields(body, map[string]any{"generationConfig": config})
+	}
+	return withBodyEffort(to, body, effort)
+}
