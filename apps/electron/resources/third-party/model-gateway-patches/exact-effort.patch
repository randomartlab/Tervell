+package gateway
+
+import (
+	"context"
+	"encoding/json"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/tidwall/gjson"
+	"github.com/yetone/magpie/internal/provider"
+)
+
+func TestTervellExplicitVendorEffort(t *testing.T) {
+	fresh(t)
+	upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		io.WriteString(w, `{"data":[{"id":"vendor-model","reasoning":true,"supported_reasoning_levels":[{"effort":"none"},{"effort":"low"},{"effort":"high"},{"effort":"ultra"},{"effort":"vendor-future"}]}]}`)
+	}))
+	defer upstream.Close()
+	p := provider.Provider{ID: "tervell-fixture", Name: "Fixture", Key: "fixture", Chat: upstream.URL + "/v1", Models: []string{"vendor-model"}}
+	if err := provider.Save(p); err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err := p.Refetch(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	ctx := provider.WithModel(context.Background(), p.ID, "vendor-model")
+	for _, proto := range []provider.Protocol{provider.Chat, provider.Responses, provider.Anthropic, provider.Gemini} {
+		for _, effort := range []string{"ultra", "vendor-future"} {
+			body := []byte(`{"model":"vendor-model","reasoning_effort":"high","reasoning":{"effort":"high"},"output_config":{"effort":"high"},"generationConfig":{"thinkingConfig":{"thinkingLevel":"high"}}}`)
+			out := tervellExactEffort(context.WithValue(ctx, tervellEffortKey{}, effort), p, proto, body)
+			got := bodyEffort(proto, out)
+			if proto == provider.Gemini {
+				got = gjson.GetBytes(out, "generationConfig.thinkingConfig.thinkingLevel").String()
+			}
+			if !json.Valid(out) || got != effort {
+				t.Fatalf("%s/%s: %s", proto, effort, out)
+			}
+			if string(tervellExactEffort(context.WithValue(context.WithValue(ctx, tervellEffortKey{}, effort), tervellEffortAllowed{}, false), p, proto, body)) != string(body) {
+				t.Fatal("group override ignored")
+			}
+			blocked := context.WithValue(ctx, tervellEffortKey{}, "unsupported")
+			if string(tervellExactEffort(blocked, p, proto, body)) != string(body) {
+				t.Fatal("unsupported effort changed body")
+			}
+		}
+	}
+}
