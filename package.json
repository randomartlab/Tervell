{
  "name": "proma",
  "version": "0.1.54",
  "description": "Tervell，面向个人项目的 Agent 工作台",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter='@proma/electron' dev",
    "electron:dev": "bun run --filter='@proma/electron' dev",
    "electron:build": "bun run --filter='@proma/electron' build",
    "electron:start": "bun run --filter='@proma/electron' start",
    "dist:mac": "bun run --filter='@proma/electron' dist:mac",
    "dist:win": "bun run --filter='@proma/electron' dist:win",
    "dist:linux": "bun run --filter='@proma/electron' dist:linux",
    "build": "bun run --filter='*' build",
    "typecheck": "bun run --sequential --filter='*' typecheck",
    "test": "bun test --isolate",
    "test:auth": "bun test packages/auth-bridge",
    "check:schedule": "node ../RAE/tools/check-schedule.mjs",
    "lint:boundaries": "node scripts/lint-boundaries.mjs",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "gen:check": "bun scripts/check-contracts.ts",
    "gen:write": "bun scripts/check-contracts.ts --write",
    "verify:wave": "bun scripts/verify-wave.ts",
    "lint": "bun run lint:boundaries && bun run lint:tokens",
    "test:headless": "bun scripts/test-headless.ts",
    "web:dev": "bun run --cwd apps/web dev",
    "web:build": "bun run --cwd apps/web build",
    "web:fixture": "bun scripts/web-fixture.ts --qa",
    "verify:mobile-tunnel": "bun scripts/verify-mobile-tunnel.ts",
    "provision:mobile-tunnel": "python3 services/relay/provision-tunnel.py",
    "record:acp:scripted": "bun scripts/record-acp-fixtures.ts",
    "verify:omp:live": "bun scripts/verify-omp-live.ts",
    "verify:acp:live-coverage": "bun scripts/check-acp-live-coverage.ts",
    "verify:acp:drift": "bun scripts/check-acp-drift.ts",
    "dist:alpha:mac": "bun run --filter=@proma/electron dist:alpha:mac",
    "dist:alpha:mac:plan": "bun run --filter=@proma/electron dist:alpha:mac:plan"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "dompurify": "^3.4.2",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "jotai": "^2.17.1",
    "jotai-family": "^1.1.0"
  },
  "overrides": {
    "@earendil-works/pi-agent-core": "0.87.1",
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1"
  },
  "patchedDependencies": {
    "@earendil-works/pi-ai@0.87.1": "patches/@earendil-works%2Fpi-ai@0.87.1.patch",
    "node-pty@1.1.0": "patches/node-pty@1.1.0.patch"
  }
}
